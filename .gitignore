# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# zip files
*.zip

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# The audit docs live on the local-only `audit` branch — this repo is public and
# they itemise live weaknesses. `git worktree add .audit audit` puts them here as
# ordinary files while keeping them off `dev`.
.audit/

# Lock files
# .terraform.lock.hcl is deliberately NOT ignored: CI runs `terraform init`
# fresh, so without it the providers float to whatever is newest. On 2026-09-08
# that resolved kislerdm/neon 0.17.0, which removed an argument we use, and the
# deploy failed at plan.

# Lambda zip files generated during build
**/lambda_function.zip

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# local
*.env